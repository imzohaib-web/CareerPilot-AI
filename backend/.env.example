# MongoDB connection string (local or Atlas). Database name defaults to careerpilot_ai.
MONGODB_URI=

# Optional: override database name (default: careerpilot_ai)
# MONGODB_NAME=careerpilot_ai

# Secret used to sign JWTs. Generate a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# Optional: JWT lifetime in minutes (default: 1440 = 24 hours)
# JWT_EXPIRES_MINUTES=1440

# Alibaba Cloud Model Studio (DashScope) API key for Qwen
ALIBABA_CLOUD_API_KEY=

# Optional: OpenAI-compatible endpoint (workspace endpoint or default DashScope)
# ALIBABA_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: Qwen model name
# ALIBABA_CLOUD_MODEL=qwen-plus

# Optional: default Qwen request timeout in seconds (default: 60)
# QWEN_TIMEOUT=60

# Optional: enable Qwen3 thinking mode (default: false).
# Thinking adds latency and wraps responses in <think> tags — disable for
# structured JSON output features like resume analysis.
# QWEN_ENABLE_THINKING=false

# Optional: DashScope text embedding model (default: text-embedding-v3)
# EMBEDDING_MODEL=text-embedding-v3

# Optional: Embedding vector dimensions (default: 1024)
# EMBEDDING_DIMENSIONS=1024

# Optional: Embedding request timeout in seconds (default: 30)
# EMBEDDING_TIMEOUT=30

# Optional: Embedding batch size per request (default: 10)
# EMBEDDING_BATCH_SIZE=10

# Optional: Minimum similarity threshold for RAG retrieval filtering (default: 0.30)
# RAG_MIN_SIMILARITY=0.30

# Comma-separated list of allowed frontend origins for CORS.
# In deployment, include BOTH the local dev origin and the production
# Vercel origin (trailing slashes, spaces after commas, and surrounding
# quotes/brackets are tolerated and normalized away):
# FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,https://your-app.vercel.app

# Optional: maximum resume file size in MB (default: 5)
# RESUME_MAX_SIZE_MB=5

# Optional: SMTP for email alerts after skill assessments. In-app alerts work without this.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=CareerPilot AI <no-reply@example.com>
# SMTP_USE_STARTTLS=true

# ==============================================================================
# Rate Limiting & Abuse Prevention
# ==============================================================================
# Master switch for rate limiting (default: true; set to false in test suites)
# RATE_LIMIT_ENABLED=true

# Storage URI for slowapi limit counters (default: in-memory per-process).
# The app currently runs as a single uvicorn worker on Render free tier.
# For horizontal scaling across multiple workers, point to Redis: redis://localhost:6379/0
# RATE_LIMIT_STORAGE_URI=

# Trust proxy X-Forwarded-For header first hop (default: true for Render reverse proxy)
# TRUSTED_PROXY=true

# Auth Endpoints Rate Limits
# AUTH_LOGIN_RATE_LIMIT=5/minute
# AUTH_LOGIN_RATE_LIMIT_HOUR=20/hour
# AUTH_LOGIN_MAX_FAILED_ATTEMPTS=10
# AUTH_LOGIN_LOCKOUT_MINUTES=15
# AUTH_REGISTER_RATE_LIMIT=3/hour

# High-Cost AI Routes (Resume Analyze, Roadmap Generate, Mock Interview Start/Submit, Skill Gap)
# AI_HIGH_COST_PER_MINUTE=6
# AI_HIGH_COST_DAILY_LIMIT=40

# Medium-Cost AI Routes (AI Career Mentor Chat, RAG Grounded Chat, AI Test)
# AI_MEDIUM_COST_PER_MINUTE=20
# AI_MEDIUM_COST_DAILY_LIMIT=200

# Low-Cost RAG Routes (Vector Query, Document Upload)
# AI_LOW_COST_PER_MINUTE=30
# RAG_MAX_DOCUMENTS_PER_USER=20
# RAG_MAX_TEXT_BYTES_PER_USER=2097152

# Global Circuit Breaker (Total LLM calls per minute across all users)
# GLOBAL_LLM_CALLS_PER_MINUTE=120

# Demo User Bypass: Comma-separated list of emails that receive 5x rate and quota limits
# ALLOWED_DEMO_USERS=demo@careerpilot.ai,judge@hackathon.com
